{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "email4iran",            // must match the Worker name in CF dashboard
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}